# ---------- ScrobbleScope Example .env ----------
# Copy this file to `.env` and replace the placeholders.
# Never commit the real .env file.

# === External API Credentials ===
LASTFM_API_KEY=your_lastfm_api_key
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# === Flask Settings ===
FLASK_ENV=development        # Options: development | production
SECRET_KEY=changeme_in_production  # REQUIRED in production. Startup fails if missing or set to this placeholder. Generate: python -c "import os; print(os.urandom(32).hex())"

# === Database (Postgres on Fly.io) ===
DATABASE_URL=              # Set automatically by `fly postgres attach`; leave blank for local dev (cache disabled)

# === Logging Debug Settings ===
DEBUG_MODE="0" # Set to "1" to enable debug mode, "0" to disable

# === GitHub CLI / API (optional) ===
# Required only if you want `gh` to authenticate non-interactively, or for
# agents to open PRs / read reviews on your behalf. Generate at:
#   https://github.com/settings/personal-access-tokens/new
# Fine-grained, scoped to this repo only:
#   - Contents: Read and write
#   - Pull requests: Read and write
#   - Metadata: Read (auto)
#   - Workflows: Read and write   (only if reviewers may ask for CI changes)
# 90-day expiry recommended. Never paste this value into chat or commit it.
GH_TOKEN=
