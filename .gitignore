# Environment variables (API keys)
.env

# Claude Code agent state -- SESSION_CONTEXT.md is committed (shared across all agents)
.claude/*
!.claude/SESSION_CONTEXT.md

# Logs
*.log
/logs/
oldlogs/

# Python cache/compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE / OS specific files
.vscode/
.DS_Store

# Template Backups
templates/backups/

# Virtual environment (to come)
venv/
*.venv
env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Pytest cache and coverage artifacts
.pytest_cache/
.coverage

# Frontend-gate console captures. A single run writes ~600 KB, and diagnosing
# one CI stall takes several, so these accumulated to ~3 MB of untracked root
# noise during Batch 21. The gate prints its verdict to the terminal and the
# workflow uploads what CI needs; a transcript kept for local reading is not
# repository state. Anchored to the root so a future scripts/ output of the
# same name is not silently hidden.
/gate_out*.txt
/gate_summary.txt

# Editor and migration scaffolding: a half-written config or a hand-made
# backup of a tracked file. Git already holds every previous revision, so a
# committed backup is a second copy free to drift.
*.new
*_backup.toml

# VS Code Local History
.vscode/History/

# OS crap
Thumbs.db
Backup_batch
backup.py
# HANDOFF_PROMPT.md and AGENT_NOTES.md are committed -- shared cross-agent bootstrap.
# MEMORY.md (root) stays local-only: Claude Code auto-memory scratch layer.
MEMORY.md
# CLAUDE.md is local-only: Claude Code auto-load convenience; not useful without Claude Code.
CLAUDE.md
/BATCH*_AUDIT*.md

# Vendored agent skills and their lockfile. Sourced from obra/superpowers and
# mattpocock/skills; harness state for a local agent setup, not project state.
# Tracked project guidance lives in AGENTS.md and .github/instructions/.
.agents/

# Agent-session analysis scratch and tool state. Untracked by intent: the
# impeccable skill's workflow copies and live session logs, the qlty analyser's
# cache and results, and the deeper-reading traversal run root (source
# manifest, chunk evidence, rendered traversal report). None of it is project
# state, but left unignored it put 500-odd untracked paths in every
# `git status`, and the only thing keeping it out of a commit was the ban on
# `git add -A`. The singular `.agent/` is deliberate: `.agents/` above is the
# vendored skill pack, a different directory.
.agent/
.impeccable/
.qlty/
scratch/

skills-lock.json

# Unedited vendor templates emitted by the setup-matt-pocock-skills skill.
# Kept locally for reference. They describe a CONTEXT.md / docs/adr/ layout
# this repo does not use and cite skills it does not have installed, so they
# are not repo guidance.
#
# Narrowed 2026-09-11. Two repo-authored files under this path ARE guidance:
# they record where this repo's issues and its domain documents actually live,
# and AGENTS.md links to them, so they have to be tracked -- an ignored path
# cannot resolve, and docsync's DOC001 check reads `git ls-files`. Only the
# skill's own seed templates stay ignored; un-ignoring those would put a
# CONTEXT.md / docs/adr/ layout this repo rejects back into the repository as a
# second source of truth.
docs/agents/*
!docs/agents/issue-tracker.md
!docs/agents/domain.md

# Mermaid authoring and preview scratch. Canonical diagrams live in tracked
# Markdown, which is what GitHub renders; a tracked .mmd would be a second
# copy free to drift. See .github/instructions/mermaid.instructions.md.
*.mmd

# Playwright MCP scratch: console logs and page snapshots from the browser
# tooling. The console file already matched *.log above, but the .yml page
# dump did not, so this directory kept showing as untracked. Batch 21 makes
# Playwright a per-WP gate, so it would otherwise resurface on every run.
.playwright-mcp/

# Downloaded Tailwind standalone and daisyUI bundles; verified on every use.
/scripts/bin/*
!/scripts/bin/.gitkeep

# Generated semantic index; retain locally and query as needed.
/graphify-out/
